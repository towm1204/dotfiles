{
  "model": "opus[1m]",
  "hooks": {
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/claude/dotfile-commit.sh 2>/dev/null &"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "git branch --show-current 2>/dev/null | sed 's|.*/||'"
  },
  "autoMemoryEnabled": false
}
