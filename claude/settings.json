{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(claude config get:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(mypy:*)",
      "Bash(xargs:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(make:*)",
      "Bash(python3*rotate-increase-sub.py*)",
      "Bash(git:*)",
      "Bash(SKIP='mypy' git commit:*)",
      "Bash(docker ps:*)",
      "Bash(curl -s http://localhost:4040/api/tunnels)",
      "Bash(curl*https://api.hellosign.com/v3/account*)",
      "Bash(curl*https://sandbox.increase.com/api/event_subscriptions*)",
      "Read(//tmp/**)",
      "Read(//Users/tow-cfp/.claude/**)",
      "Read(//Users/tow-cfp/**)",
      "Skill(update-config)",
      "Bash(yarn build:*)",
      "Bash(yarn workspace:*)",
      "Bash(tsc:*)",
      "Bash(npx tsc:*)",
      "Bash(gh pr:*)",
      "mcp__github__get_pull_request",
      "mcp__github__get_pull_request_files",
      "Bash(REACT_APP_ENV=production NODE_OPTIONS=--max-old-space-size=5120 yarn build:portal)",
      "Bash(gh repo:*)",
      "Bash(~/.claude/skills/note/scripts/note-list.sh *)",
      "Bash(~/.claude/skills/note/scripts/note-find.sh *)",
      "Bash(yarn why *)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f graphify-out/graph.json ] && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"graphify: Knowledge graph exists. Read graphify-out/GRAPH_REPORT.md for god nodes and community structure before searching raw files.\"}}' || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "effortLevel": "medium",
  "showClearContextOnPlanAccept": true,
  "tui": "default",
  "autoMemoryEnabled": false,
  "autoDreamEnabled": false,
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": false,
  "model": "haiku"
}
