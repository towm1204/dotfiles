{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(claude config get:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(mypy:*)",
      "Bash(xargs:*)",
      "Bash(pytest:*)",
      "Bash(make:*)",
      "Bash(python3 -c*increase*)",
      "Bash(git:*)",
      "Bash(docker ps:*)",
      "Bash(curl -s http://localhost:4040/api/tunnels)",
      "Bash(curl*https://api.hellosign.com/v3/account*)",
      "Bash(curl*https://sandbox.increase.com/api/event_subscriptions*)",
      "Read(//tmp/**)",
      "Read(//Users/tow-cfp/.claude/**)",
      "Read(//Users/tow-cfp/**)",
      "Skill(update-config)",
      "Bash(yarn build:*)",
      "Bash(yarn workspace:*)",
      "Bash(tsc:*)",
      "Bash(npx tsc:*)",
      "Bash(gh pr:*)",
      "mcp__github__get_pull_request",
      "mcp__github__get_pull_request_files",
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "git branch --show-current 2>/dev/null | sed 's|.*/||'"
  },
  "autoMemoryEnabled": false,
  "model": "opus[1m]"
}
